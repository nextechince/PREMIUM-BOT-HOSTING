{
  "name": "premium-hosting-bot",
  "version": "2.0.0",
  "description": "Ultimate Premium Hosting Bot - Deploy Any Bot or Website",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "dev": "nodemon bot.js",
    "test": "node bot.js",
    "pm2": "pm2 start bot.js --name hosting-bot",
    "pm2:stop": "pm2 stop hosting-bot",
    "pm2:restart": "pm2 restart hosting-bot",
    "pm2:logs": "pm2 logs hosting-bot",
    "install:all": "npm install && pip install -r requirements.txt 2>/dev/null || true"
  },
  "dependencies": {
    "node-telegram-bot-api": "^0.61.0",
    "adm-zip": "^0.5.10",
    "axios": "^1.6.2",
    "form-data": "^4.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.1.1",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "moment": "^2.29.4",
    "node-fetch": "^2.7.0",
    "ws": "^8.14.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pm2": "^5.3.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/premium-hosting-bot.git"
  },
  "keywords": [
    "telegram-bot",
    "hosting-bot",
    "bot-hosting",
    "website-hosting",
    "deployment-bot",
    "python-hosting",
    "nodejs-hosting",
    "vercel-deployment",
    "premium-bot"
  ],
  "author": "Loner Territory",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yourusername/premium-hosting-bot/issues"
  },
  "homepage": "https://github.com/yourusername/premium-hosting-bot#readme"
}
