    "dotenv": "^16.3.1",
    "fs-extra": "^11.1.1",
    "chalk": "^4.1.2",
    "moment": "^2.29.4",
    "node-fetch": "^2.7.0",
    "ws": "^8.14.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.0.0",
    "@slack/webhook": "^7.0.1",
    "@octokit/rest": "^20.0.2",
    "openai": "^4.20.1",
    "node-cron": "^3.0.2",
    "express-rate-limit": "^7.1.5",
    "compression": "^1.7.4",
    "uuid": "^9.0.1",
